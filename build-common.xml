                    <fileset dir="${common.dir}/src/java"/>
                </sourcefiles>
            </structure>
            <html destdir="${common.dir}/build/coverage/html"/>
            <xml destfile="${common.dir}/build/coverage/report.xml"/>
            <csv destfile="${common.dir}/build/coverage/report.csv"/>
        </jacoco:report>
        <!-- ============================= -->
        <!-- CLIENT COVERAGE REPORT        -->

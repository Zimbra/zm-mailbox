# Copy to local.env and fill in.  local.env is gitignored -- never commit it.
#
#   cp local.env.example local.env
#
# Both the Python and the shell scripts in saml-mfa/ and preauth-mfa/ read this file.

# --- Zimbra ---------------------------------------------------------------
ZIMBRA_HOST=your-zcs-host.example.com
ZIMBRA_DOMAIN=your-zcs-host.example.com

# Accounts used by the tests. TEST_RECOVERY receives the 2FA codes, so it must be
# a different mailbox from TEST_USER.
TEST_USER=rm1
TEST_RECOVERY=rm2@your-zcs-host.example.com

# --- IdP ------------------------------------------------------------------
# Password of the Keycloak test users. Test accounts only.
IDP_TEST_PASSWORD=changeme

# --- PreAuth --------------------------------------------------------------
# Domain PreAuth key: `zmprov gdpak <domain>`.
#
# TREAT AS A CREDENTIAL. It can mint a login for ANY account in the domain, with no
# password. Do not paste it into a ticket, a chat, or a commit. Rotate with the same
# command if it is ever exposed.
PREAUTH_KEY=
